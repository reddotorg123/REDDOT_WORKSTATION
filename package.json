{
  "name": "reddot-workstation-os",
  "version": "2.5.3",
  "description": "REDDOT Architecture & Executive Workstation OS with Native Windows Desktop Wallpaper & System Tray for Jagadish K",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reddotorg123/REDDOT_WORKSTATION.git"
  },
  "homepage": "https://github.com/reddotorg123/REDDOT_WORKSTATION#readme",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "ota:publish": "node scripts/publish-ota.js"
  },
  "build": {
    "electronVersion": "34.5.8",
    "appId": "com.reddot.workstation",
    "productName": "REDDOT Workstation OS",
    "copyright": "Copyright © 2026 REDDOT Technologies",
    "directories": {
      "output": "app/v${version}"
    },
    "files": [
      "main.js",
      "preload.js",
      "wallpaper-ui/**/*"
    ],
    "artifactName": "${productName}-${version}-${target}.${ext}",
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "wallpaper-ui/assets/id-card.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "REDDOT Workstation OS",
      "artifactName": "REDDOT-Workstation-OS-Setup.${ext}"
    },
    "portable": {
      "artifactName": "REDDOT-Workstation-OS-Portable.${ext}"
    }
  },
  "keywords": [
    "desktop-wallpaper",
    "windows-wallpaper",
    "system-tray",
    "admin-panel",
    "timesheets",
    "jagadish-k"
  ],
  "author": "Jagadish K",
  "license": "MIT",
  "devDependencies": {
    "electron": "34.5.8",
    "electron-builder": "^26.15.3"
  }
}
