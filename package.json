{
  "name": "reddot-workstation-os",
  "version": "3.13.2",
  "description": "REDDOT Architecture & Executive Workstation OS with Native Windows Desktop Wallpaper & System Tray for Jagadish K",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reddotorg123/REDDOT_WORKSTATION.git"
  },
  "homepage": "https://github.com/reddotorg123/REDDOT_WORKSTATION#readme",
  "scripts": {
    "start": "electron .",
    "dev:ui": "npm --prefix react-app run dev",
    "build:ui": "npm --prefix react-app run build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage deb",
    "ota:publish": "node scripts/publish-ota.js"
  },
  "build": {
    "electronVersion": "34.5.8",
    "appId": "com.reddot.workstation",
    "productName": "REDDOT WS",
    "copyright": "Copyright © 2026 REDDOT Technologies",
    "directories": {
      "output": "app/v${version}"
    },
    "files": [
      "main.js",
      "preload.js",
      "version.json",
      "wallpaper-ui/**/*"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "wallpaper-ui/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "REDDOT WS",
      "artifactName": "REDDOT-WS-Setup.${ext}"
    },
    "portable": {
      "artifactName": "REDDOT-WS-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "wallpaper-ui/assets/icon.png"
    }
  },
  "keywords": [
    "desktop-wallpaper",
    "windows-wallpaper",
    "system-tray",
    "admin-panel",
    "timesheets",
    "jagadish-k"
  ],
  "author": "Jagadish K",
  "license": "MIT",
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}