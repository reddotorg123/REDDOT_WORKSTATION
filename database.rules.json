{
  "rules": {
    "organizations": {
      "reddot": {
        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['state', 'lastSeenAt']) && newData.child('state').isString() && (newData.child('state').val() == 'online' || newData.child('state').val() == 'offline' || newData.child('state').val() == 'away' || newData.child('state').val() == 'break')"
          }
        }
      }
    }
  }
}
