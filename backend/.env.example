# REDDOT Workstation Attachment Gateway Configuration
PORT=5050

# Optional Google Drive Service Account Key path (if omitted, falls back to secure local vault)
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Optional specific Google Drive Folder / Shared Drive ID
GDRIVE_FOLDER_ID=

# Optional OAuth2 credentials (alternative to service account)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
